{
  "name": "@deepseek-ai/dsh-harmony-compat",
  "version": "0.1.0",
  "description": "HarmonyOS adaptation settings for DeepSeek Harness: a General-settings keep-alive switch whose value is mirrored to $DSH_HOME/harmony-native.json",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ]
}
